{
  "name": "llvm-runtime-lld-darwin-arm64",
  "version": "22.1.8",
  "description": "The macOS ARM 64-bit binaries for the LLVM linker",
  "exports": {
    ".": "./index.js",
    "./package": "./package.json"
  },
  "bin": {
    "ld.lld": "bin/ld.lld",
    "ld64.lld": "bin/ld64.lld",
    "lld": "bin/lld",
    "lld-link": "bin/lld-link",
    "wasm-ld": "bin/wasm-ld"
  },
  "files": [
    "NOTICE",
    "index.js",
    "bin"
  ],
  "assets": [
    "bin"
  ],
  "scripts": {
    "prepack": "node ../../prepack.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/llvm-runtime.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/llvm-runtime/issues"
  },
  "homepage": "https://github.com/holepunchto/llvm-runtime#readme",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "dependencies": {
    "llvm-runtime-clang-darwin-arm64": "22.1.8",
    "require-asset": "^1.2.3"
  }
}
